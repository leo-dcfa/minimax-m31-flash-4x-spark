# Site-specific values. Copy to site.env (git-ignored) on each node and fill in.
# Shell syntax: the scripts source this file.

# ssh names of the four nodes, in rank order (rank order = ring order; rank 0 is the head).
NODES="node0 node1 node2 node3"
# Each node's ring0 address, in the same order. Rank 0's is the vLLM master address.
RING_IPS="10.0.0.1 10.0.0.2 10.0.0.3 10.0.0.4"
# How the head reaches ranks 1-3 by ssh (rank order), over the fabric: launch.sh and stop.sh use it.
WORKERS_FROM_HEAD="10.0.0.2 10.0.0.3 10.0.0.4"
# The address the head's API server binds: one only your clients can reach, never 0.0.0.0.
API_HOST=100.64.0.1
API_PORT=8000
# mode-600 file holding VLLM_API_KEY=..., passed to the head's container with --env-file.
API_KEY_ENV="$HOME/.config/minimax-m31-flash/api.env"

# Where the weights live on every node (same path on all four).
MODEL_DIR="$HOME/models/MiniMax-M3.1-Flash"
# The patched NCCL build (same file, same sha256, on all four).
NCCL_LIB="$HOME/nccl-2.30.7/libnccl.so.2.30.7"
# The hf CLI (pip install -U "huggingface_hub[hf_xet]").
HF=hf
