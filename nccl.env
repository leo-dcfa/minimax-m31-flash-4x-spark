# NCCL settings for TP4 over a switchless four-GB10 CX7 ring, passed to every rank with --env-file.
# Copied unchanged from an SGLang TP4 deployment that serves on the same kind of ring with the same
# patched NCCL 2.30.7 build; change one only with a reason and a before/after measurement.

# Bootstrap (rendezvous, control messages) over ring0, the routed address every node has.
NCCL_SOCKET_IFNAME=ring0
GLOO_SOCKET_IFNAME=ring0

# Data over RoCE on the CX7 ports: one port per cable, each cable to a different neighbour.
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
# The RoCE v2 / IPv4 entry in each port's GID table.
NCCL_IB_GID_INDEX=3
# Keep the two ports as separate NICs (they reach different neighbours) and let a ring leave by a
# different port than it arrived on.
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1

# Switchless ring: the patched build's ring-only mode, each cable its own /24, ports matched to
# peers by subnet.
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_SUBNET_PREFIX_LEN=24

# Ring all-reduce only: no tree on a ring without a switch.
NCCL_ALGO=Ring
NCCL_SKIP_TREE_CONNECT=1
# No LL128 protocol over these links.
NCCL_PROTO=^LL128
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144

# One GPU per node: no intra-node peer-to-peer or shared-memory transport.
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_P2P_LEVEL=SYS
NCCL_CUMEM_ENABLE=0

NCCL_DEBUG=WARN
NCCL_DEBUG_SUBSYS=INIT,ENV
